spring.application.name=api-service-java

# curaflow-daten branch profile: OAuth 2.0 via UAA
sap.cps.base-url=https://<cps-tenant-runtime-host>
sap.cps.uaa-url=https://<tenant-uaa-host>
sap.cps.client-id=<CPS_CLIENT_ID>
sap.cps.client-secret=<CPS_CLIENT_SECRET>

# local snapshot storage
app.configurations-db.path=configurations-db
