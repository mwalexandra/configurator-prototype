spring.application.name=api-service-java

# curaflow-daten branch profile: OAuth 2.0 Client Credentials via UAA
sap.cps.base-url=${CPS_API_URL}

sap.cps.uaa-url=${CPS_UAA_URL}
sap.cps.client-id=${CPS_CLIENT_ID}
