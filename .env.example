# Shared
# Copy to a local, ignored .env file and fill secrets.

# -----------------------------
# main branch (API Key profile)
# -----------------------------
MAIN_CPS_BASE_URL=https://<sap-business-hub-cps-host>
MAIN_CPS_API_KEY=<SAP_API_KEY>
MAIN_PRODUCT_ID=CPS_BURGER
MAIN_KB_ID=<BURGER_KB_ID>

# -----------------------------------------
# curaflow-daten branch (OAuth/UAA profile)
# -----------------------------------------
CPS_API_URL=https://<cps-tenant-runtime-host>
CPS_UAA_URL=https://<tenant-uaa-host>
CPS_CLIENT_ID=<CPS_CLIENT_ID>
CPS_CLIENT_SECRET=<CPS_CLIENT_SECRET>
CURAFLOW_PRODUCT_ID=<CURAFLOW_PRODUCT_ID>
CURAFLOW_KB_ID=<CURAFLOW_KB_ID>
CURAFLOW_VERIFICATION_KEY=<CURAFLOW_VERIFICATION_KEY>
